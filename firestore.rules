rules_version = '2';

/**
 * LifeFlow — Firestore security rules.
 * Every document lives under users/{uid}, and only that signed-in user can
 * read or write it. Nothing is publicly readable.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validSize(field, max) {
      return !(field in request.resource.data)
        || !(request.resource.data[field] is string)
        || request.resource.data[field].size() <= max;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && validSize('name', 120)
                    && validSize('bio', 500);
      allow update: if isOwner(uid)
                    && validSize('name', 120)
                    && validSize('bio', 500);
      allow delete: if isOwner(uid);

      // All user-owned sub-collections share the same ownership rule.
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
                           && collection in [
                                'tasks', 'events', 'goals', 'savings',
                                'txns', 'purchases', 'habits', 'notes',
                                'moods', 'prayers'
                              ];
      }
    }

    /**
     * Game rooms are the one shared space in LifeFlow. They hold nothing but a
     * board position and the signalling needed to open a video call, and they
     * are found by an unguessable code rather than by listing.
     */
    match /rooms/{code} {
      function signedIn() {
        return request.auth != null;
      }
      function player() {
        return signedIn()
               && (resource.data.hostUid == request.auth.uid
                   || resource.data.guestUid == request.auth.uid);
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code;
      function claimingGuest() {
        return signedIn()
               && resource.data.guestUid == null
               && request.resource.data.guestUid == request.auth.uid
               && request.resource.data.guestTab is string
               && request.resource.data.guestJoin is string
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'guestUid', 'guestTab', 'guestJoin', 'guest', 'offer', 'answer',
                    'media', 'rematch', 'updatedAt'
                  ])
               && request.resource.data.media.a == resource.data.media.a
               && request.resource.data.rematch.a == resource.data.rematch.a;
      }
      // Claiming a seat must not also overwrite the host, board, or chat.
      allow update: if claimingGuest() || (player()
                    && request.resource.data.hostUid == resource.data.hostUid
                    && request.resource.data.hostTab == resource.data.hostTab
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.gameId == resource.data.gameId
                    && (request.resource.data.guestUid == resource.data.guestUid
                        || (resource.data.guestUid == request.auth.uid
                            && request.resource.data.guestUid == null)));
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // ICE candidates for the call — short-lived and meaningless on their own.
      match /{lane}/{candidate} {
        function roomPlayer() {
          let room = get(/databases/$(database)/documents/rooms/$(code)).data;
          return signedIn() && (room.hostUid == request.auth.uid || room.guestUid == request.auth.uid);
        }
        allow read, write: if lane in ['iceHost', 'iceGuest'] && roomPlayer();
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
