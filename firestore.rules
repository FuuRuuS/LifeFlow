rules_version = '2';

/**
 * LifeFlow — Firestore security rules.
 * Every document lives under users/{uid}, and only that signed-in user can
 * read or write it. Nothing is publicly readable.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validSize(field, max) {
      return !(field in request.resource.data)
        || !(request.resource.data[field] is string)
        || request.resource.data[field].size() <= max;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && validSize('name', 120)
                    && validSize('bio', 500);
      allow update: if isOwner(uid)
                    && validSize('name', 120)
                    && validSize('bio', 500);
      allow delete: if isOwner(uid);

      // All user-owned sub-collections share the same ownership rule.
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
                           && collection in [
                                'tasks', 'events', 'goals', 'savings',
                                'txns', 'purchases', 'habits', 'notes',
                                'moods', 'prayers'
                              ];
      }
    }

    /**
     * Game rooms are the one shared space in LifeFlow. They hold nothing but a
     * board position and the signalling needed to open a video call, and they
     * are found by an unguessable code rather than by listing.
     */
    match /rooms/{code} {
      function signedIn() {
        return request.auth != null;
      }
      function player() {
        return signedIn()
               && (resource.data.hostUid == request.auth.uid
                   || resource.data.guestUid == request.auth.uid);
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code;
      // Either player may play; an empty room may also be claimed by a guest.
      allow update: if player() || (signedIn() && resource.data.guestUid == null);
      allow delete: if player();

      // ICE candidates for the call — short-lived and meaningless on their own.
      match /{lane}/{candidate} {
        allow read, write: if signedIn() && lane in ['iceHost', 'iceGuest'];
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
